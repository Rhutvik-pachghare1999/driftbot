<?xml version="1.0" ?>
<!--
  driftbot_corridor.sdf — DriftBot cardboard corridor test world (Gazebo Harmonic)

  Mirrors the real test track: cardboard boxes/walls forming a corridor.
  Corridor: 8 m long (x from -2 to +6), 2.4 m wide (y from -1.2 to +1.2),
  0.4 m high cardboard walls, plus end caps and two box obstacles.

  Run:
    GZ_SIM_RESOURCE_PATH=<pkg>/share/driftbot_bringup/gz/models \
      gz sim -s -r --headless-rendering <pkg>/share/driftbot_bringup/gz/worlds/driftbot_corridor.sdf
-->
<sdf version="1.9">
  <world name="driftbot_corridor">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics" />
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands" />
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster" />
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu" />
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>50</mu>
                <mu2>50</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.6 0.6 0.6 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ── Cardboard corridor walls (tan) ────────────────────────────────── -->
    <model name="corridor_left_wall">
      <static>true</static>
      <pose>2 1.25 0.2 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>8.4 0.1 0.4</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>8.4 0.1 0.4</size>
            </box>
          </geometry>
          <material>
            <ambient>0.82 0.71 0.55 1</ambient>
            <diffuse>0.82 0.71 0.55 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="corridor_right_wall">
      <static>true</static>
      <pose>2 -1.25 0.2 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>8.4 0.1 0.4</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>8.4 0.1 0.4</size>
            </box>
          </geometry>
          <material>
            <ambient>0.82 0.71 0.55 1</ambient>
            <diffuse>0.82 0.71 0.55 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="corridor_back_wall">
      <static>true</static>
      <pose>-2.3 0 0.2 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.1 2.6 0.4</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.1 2.6 0.4</size>
            </box>
          </geometry>
          <material>
            <ambient>0.82 0.71 0.55 1</ambient>
            <diffuse>0.82 0.71 0.55 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="corridor_front_wall">
      <static>true</static>
      <pose>6.3 0 0.2 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.1 2.6 0.4</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.1 2.6 0.4</size>
            </box>
          </geometry>
          <material>
            <ambient>0.82 0.71 0.55 1</ambient>
            <diffuse>0.82 0.71 0.55 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Box obstacles inside the corridor (0.5 m tall: above the Jackal's
       lidar plane at ~0.30 m, below the 0.4 m corridor walls) -->
    <model name="box_left">
      <static>true</static>
      <pose>3.5 0.8 0.25 0 0 0.4</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.3 0.3 0.5</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.3 0.3 0.5</size>
            </box>
          </geometry>
          <material>
            <ambient>0.75 0.6 0.4 1</ambient>
            <diffuse>0.75 0.6 0.4 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="box_right">
      <static>true</static>
      <pose>4.8 -0.7 0.25 0 0 -0.3</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.25 0.25 0.5</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.25 0.25 0.5</size>
            </box>
          </geometry>
          <material>
            <ambient>0.75 0.6 0.4 1</ambient>
            <diffuse>0.75 0.6 0.4 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
