<?xml version="1.0" ?>
<!--
  DriftBot simulation model — Gazebo Harmonic (gz-sim 8)

  Real-robot dimensions (from firmware/config/calibration_data.txt and
  ros2_ws/src/driftbot_bringup/config/robot_params.yaml):
    wheelbase  0.235 m  (front axle +0.1175, rear axle -0.1175)
    track      0.128 m  (wheels at y = ±0.064)
    wheel      r = 0.032 m (64 mm dia), w = 0.02 m
    chassis    0.25 x 0.15 x 0.06 m

  Scan head:
    Rotates on scan_joint (revolute z) like the real scanning servo
    (center 96 deg, amplitude ±60 deg, 3.0 rad/s sine sweep — driven
    externally by servo_sweep.py over JointPositionController).
    3 ToF beams at mount angles (yaw CCW from forward):
      tof_2 =   0 deg (forward)
      tof_1 = 115 deg (left-rear)
      tof_0 = 180 deg (backward)
    10 Hz each, range 0.04..4.0 m (VL53L1X), 1 beam each.

  Drive:
    gz-sim AckermannSteering system, gz topic /model/driftbot/cmd_vel
    (gz.msgs.Twist), odometry /model/driftbot/odometry (gz.msgs.Odometry).

  Gazebo topics -> ros_gz_bridge -> ROS 2 (see launch/sim.launch.py):
    /model/driftbot/cmd_vel                        ROS->gz  (geometry_msgs/Twist)
    /model/driftbot/odometry                       gz->ROS  (nav_msgs/Odometry)
    /model/driftbot/joint/scan_joint/cmd_position  ROS->gz  (std_msgs/Float64)
    /tof/sensor_{0,1,2}                            gz->ROS  (sensor_msgs/LaserScan)
    /imu/data                                      gz->ROS  (sensor_msgs/Imu)
-->
<sdf version="1.9">
  <model name="driftbot">
    <self_collide>false</self_collide>

    <!-- ── Chassis (origin at model frame, center z = 0.06 m) ─────────────── -->
    <link name="chassis">
      <pose>0 0 0.06 0 0 0</pose>
      <inertial>
        <mass>1.5</mass>
        <inertia>
          <ixx>0.00326</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.00826</iyy>
          <iyz>0</iyz>
          <izz>0.01063</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry>
          <box>
            <size>0.25 0.15 0.06</size>
          </box>
        </geometry>
      </collision>
      <visual name="visual">
        <geometry>
          <box>
            <size>0.25 0.15 0.06</size>
          </box>
        </geometry>
        <material>
          <ambient>0.2 0.4 0.8 1</ambient>
          <diffuse>0.2 0.4 0.8 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>

      <!-- MPU6050 IMU — published as imu_link (static identity from base_link) -->
      <sensor name="imu" type="imu">
        <always_on>1</always_on>
        <update_rate>10</update_rate>
        <topic>/imu/data</topic>
        <gz_frame_id>imu_link</gz_frame_id>
      </sensor>

      <!-- Forward-facing camera at the chassis front -->
      <sensor name="front_camera" type="camera">
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <topic>/camera/image_raw</topic>
        <gz_frame_id>camera_link</gz_frame_id>
        <pose>0.13 0 0.02 0 0 0</pose>
        <camera>
          <horizontal_fov>1.047</horizontal_fov>
          <image>
            <width>1280</width>
            <height>720</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.02</near>
            <far>100</far>
          </clip>
        </camera>
      </sensor>
    </link>

    <!-- ── Front steering knuckles (kingpins at x=±0.1175... y=±0.064) ────── -->
    <link name="front_left_steering_link">
      <pose>0.1175 0.064 0.032 0 0 0</pose>
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>0.00001</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.00001</iyy>
          <iyz>0</iyz>
          <izz>0.00001</izz>
        </inertia>
      </inertial>
    </link>
    <link name="front_right_steering_link">
      <pose>0.1175 -0.064 0.032 0 0 0</pose>
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>0.00001</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.00001</iyy>
          <iyz>0</iyz>
          <izz>0.00001</izz>
        </inertia>
      </inertial>
    </link>

    <joint name="front_left_steering_joint" type="revolute">
      <parent>chassis</parent>
      <child>front_left_steering_link</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-0.6</lower>
          <upper>0.6</upper>
          <effort>25</effort>
          <velocity>5</velocity>
        </limit>
      </axis>
    </joint>
    <joint name="front_right_steering_joint" type="revolute">
      <parent>chassis</parent>
      <child>front_right_steering_link</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-0.6</lower>
          <upper>0.6</upper>
          <effort>25</effort>
          <velocity>5</velocity>
        </limit>
      </axis>
    </joint>

    <!-- ── Wheels (cylinder axis rolled to Y, same convention as the
         gz ackermann_steering.sdf demo) ───────────────────────────────────── -->
    <link name="front_left_wheel">
      <pose>0.1175 0.064 0.032 -1.5707 0 0</pose>
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>0.0000131</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.0000131</iyy>
          <iyz>0</iyz>
          <izz>0.0000256</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>0.032</radius>
            <length>0.02</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>1.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>0.032</radius>
            <length>0.02</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.1 0.1 0.1 1</diffuse>
        </material>
      </visual>
    </link>
    <link name="front_right_wheel">
      <pose>0.1175 -0.064 0.032 -1.5707 0 0</pose>
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>0.0000131</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.0000131</iyy>
          <iyz>0</iyz>
          <izz>0.0000256</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>0.032</radius>
            <length>0.02</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>1.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>0.032</radius>
            <length>0.02</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.1 0.1 0.1 1</diffuse>
        </material>
      </visual>
    </link>
    <link name="rear_left_wheel">
      <pose>-0.1175 0.064 0.032 -1.5707 0 0</pose>
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>0.0000131</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.0000131</iyy>
          <iyz>0</iyz>
          <izz>0.0000256</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>0.032</radius>
            <length>0.02</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>1.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>0.032</radius>
            <length>0.02</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.1 0.1 0.1 1</diffuse>
        </material>
      </visual>
    </link>
    <link name="rear_right_wheel">
      <pose>-0.1175 -0.064 0.032 -1.5707 0 0</pose>
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>0.0000131</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.0000131</iyy>
          <iyz>0</iyz>
          <izz>0.0000256</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>0.032</radius>
            <length>0.02</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>1.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>0.032</radius>
            <length>0.02</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.1 0.1 0.1 1</diffuse>
        </material>
      </visual>
    </link>

    <!-- Spin joints: axis z in each wheel's rolled frame (= model Y axle) -->
    <joint name="front_left_wheel_joint" type="revolute">
      <parent>front_left_steering_link</parent>
      <child>front_left_wheel</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
        </limit>
      </axis>
    </joint>
    <joint name="front_right_wheel_joint" type="revolute">
      <parent>front_right_steering_link</parent>
      <child>front_right_wheel</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
        </limit>
      </axis>
    </joint>
    <joint name="rear_left_wheel_joint" type="revolute">
      <parent>chassis</parent>
      <child>rear_left_wheel</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
        </limit>
      </axis>
    </joint>
    <joint name="rear_right_wheel_joint" type="revolute">
      <parent>chassis</parent>
      <child>rear_right_wheel</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
        </limit>
      </axis>
    </joint>

    <!-- ── Scan head (rotating ToF plate, z = 0.09 = chassis top) ─────────── -->
    <link name="scan_head">
      <pose>0 0 0.09 0 0 0</pose>
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>0.00001</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.00001</iyy>
          <iyz>0</iyz>
          <izz>0.00001</izz>
        </inertia>
      </inertial>
      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>0.06</radius>
            <length>0.01</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.3 0.3 0.3 1</ambient>
          <diffuse>0.3 0.3 0.3 1</diffuse>
        </material>
      </visual>

      <!-- ToF 2: forward (mount angle 0 deg) -->
      <sensor name="tof_2" type="gpu_lidar">
        <pose>0.05 0 0 0 0 0</pose>
        <always_on>1</always_on>
        <update_rate>10</update_rate>
        <topic>/tof/sensor_2</topic>
        <gz_frame_id>tof_2</gz_frame_id>
        <lidar>
          <scan>
            <horizontal>
              <samples>1</samples>
              <resolution>1</resolution>
              <min_angle>0</min_angle>
              <max_angle>0</max_angle>
            </horizontal>
            <vertical>
              <samples>1</samples>
              <resolution>1</resolution>
              <min_angle>-0.005</min_angle>
              <max_angle>0.005</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.04</min>
            <max>4.0</max>
            <resolution>0.01</resolution>
          </range>
        </lidar>
      </sensor>

      <!-- ToF 1: left-rear (mount angle 115 deg CCW) -->
      <sensor name="tof_1" type="gpu_lidar">
        <pose>0.05 0 0 0 0 2.007128640</pose>
        <always_on>1</always_on>
        <update_rate>10</update_rate>
        <topic>/tof/sensor_1</topic>
        <gz_frame_id>tof_1</gz_frame_id>
        <lidar>
          <scan>
            <horizontal>
              <samples>1</samples>
              <resolution>1</resolution>
              <min_angle>0</min_angle>
              <max_angle>0</max_angle>
            </horizontal>
            <vertical>
              <samples>1</samples>
              <resolution>1</resolution>
              <min_angle>-0.005</min_angle>
              <max_angle>0.005</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.04</min>
            <max>4.0</max>
            <resolution>0.01</resolution>
          </range>
        </lidar>
      </sensor>

      <!-- ToF 0: backward (mount angle 180 deg) -->
      <sensor name="tof_0" type="gpu_lidar">
        <pose>0.05 0 0 0 0 3.141592654</pose>
        <always_on>1</always_on>
        <update_rate>10</update_rate>
        <topic>/tof/sensor_0</topic>
        <gz_frame_id>tof_0</gz_frame_id>
        <lidar>
          <scan>
            <horizontal>
              <samples>1</samples>
              <resolution>1</resolution>
              <min_angle>0</min_angle>
              <max_angle>0</max_angle>
            </horizontal>
            <vertical>
              <samples>1</samples>
              <resolution>1</resolution>
              <min_angle>-0.005</min_angle>
              <max_angle>0.005</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.04</min>
            <max>4.0</max>
            <resolution>0.01</resolution>
          </range>
        </lidar>
      </sensor>
    </link>

    <!-- Scan joint: zero = servo at 96 deg = robot forward.
         Real servo sweeps 96 ± 60 deg; joint limits ±60 deg. -->
    <joint name="scan_joint" type="revolute">
      <parent>chassis</parent>
      <child>scan_head</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1.05</lower>
          <upper>1.05</upper>
          <effort>10</effort>
          <velocity>10</velocity>
        </limit>
      </axis>
    </joint>

    <!-- ── Systems ─────────────────────────────────────────────────────────── -->
    <plugin
      filename="gz-sim-ackermann-steering-system"
      name="gz::sim::systems::AckermannSteering">
      <left_joint>front_left_wheel_joint</left_joint>
      <left_joint>rear_left_wheel_joint</left_joint>
      <right_joint>front_right_wheel_joint</right_joint>
      <right_joint>rear_right_wheel_joint</right_joint>
      <left_steering_joint>front_left_steering_joint</left_steering_joint>
      <right_steering_joint>front_right_steering_joint</right_steering_joint>
      <kingpin_width>0.128</kingpin_width>
      <steering_limit>0.6</steering_limit>
      <wheel_base>0.235</wheel_base>
      <wheel_separation>0.128</wheel_separation>
      <wheel_radius>0.032</wheel_radius>
      <min_velocity>-0.5</min_velocity>
      <max_velocity>0.5</max_velocity>
      <min_acceleration>-1.0</min_acceleration>
      <max_acceleration>1.0</max_acceleration>
    </plugin>

    <plugin
      filename="gz-sim-joint-position-controller-system"
      name="gz::sim::systems::JointPositionController">
      <joint_name>scan_joint</joint_name>
      <!-- Custom topic: default /model/.../joint/.../0/cmd_pos is an
           invalid ROS name (numeric token) and crashes ros_gz_bridge.
           ABS mode (use_velocity_commands) moves the head at max
           3 rad/s like the real servo, bypassing PID force control. -->
      <topic>/scan_joint/cmd_pos</topic>
      <use_velocity_commands>true</use_velocity_commands>
      <cmd_max>3.0</cmd_max>
      <cmd_min>-3.0</cmd_min>
    </plugin>
  </model>
</sdf>
