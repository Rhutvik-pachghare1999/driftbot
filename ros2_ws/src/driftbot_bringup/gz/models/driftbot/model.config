<?xml version="1.0"?>
<model>
  <name>driftbot</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <description>
    DriftBot simulation model: Ackermann-steered chassis (235mm wheelbase,
    128mm track, 64mm wheels) with a rotating scan head carrying 3 VL53L1X
    ToF sensors at mount angles 180/115/0 degrees and an MPU6050 IMU.
    Dimensions from firmware/config/calibration_data.txt and
    ros2_ws/src/driftbot_bringup/config/robot_params.yaml.
  </description>
</model>
