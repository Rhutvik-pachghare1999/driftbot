digraph GazeboSim {
  rankdir=LR;
  bgcolor="white";
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=11, color="#1e3a5f", penwidth=1.4];
  edge [color="#475569", fontname="Helvetica", fontsize=9, penwidth=1.2];
  labelloc="t";
  fontsize=15;
  label="Gazebo Harmonic Simulation — Clearpath Jackal (j100) in driftbot_corridor.sdf (headless)";

  subgraph cluster_gz {
    label="gz sim 8.11 + gz_ros2_control";
    fontsize=12; color="#94a3b8"; style="rounded";
    node [fillcolor="#dbeafe"];

    gzc   [label="gz_ros2_control\ncontroller_manager", fillcolor="#bfdbfe"];
    ddc   [label="platform_velocity_controller\ndiff_drive_controller\n(official j100 tuning:\nskid-steer, covariances)", fillcolor="#bfdbfe"];
    jsb   [label="joint_state_\nbroadcaster", fillcolor="#bfdbfe"];
    lidar [label="SICK LMS1xx\ngpu_lidar 2D (30 Hz)", fillcolor="#bfdbfe"];
    imus  [label="IMU (50 Hz)", fillcolor="#bfdbfe"];
    gto   [label="gz odometry\n(ground truth)", fillcolor="#bfdbfe"];
  }

  subgraph cluster_ros_gz {
    label="ROS topics served inside gz (gz_ros2_control)";
    fontsize=12; color="#94a3b8"; style="rounded";
    node [shape=ellipse, style="filled", fillcolor="#fef9c3"];

    t_cmdvel [label="/platform/cmd_vel\nTwistStamped"];
    t_podom  [label="/platform/odom\n50 Hz"];
    t_js     [label="/platform/joint_states\n50 Hz"];
  }

  subgraph cluster_gzt {
    label="gz transport topics";
    fontsize=12; color="#94a3b8"; style="rounded";
    node [shape=ellipse, style="filled", fillcolor="#fde68a"];

    t_scan  [label="/sensors/lidar_0/scan\nLaserScan"];
    t_imu   [label="/sensors/imu_0/data_raw\nIMU"];
    t_gto   [label="/model/jackal/odometry\nOdometry"];
    t_clock [label="/clock"];
  }

  subgraph cluster_bridge {
    label="ros_gz_bridge";
    fontsize=12; color="#94a3b8"; style="rounded";
    node [fillcolor="#dcfce7"];

    bridge [label="parameter_bridge\n(/clock → sim time\nfor the whole stack)"];
  }

  subgraph cluster_laptop {
    label="laptop stack — same nodes as hardware bringup";
    fontsize=12; color="#94a3b8"; style="rounded";
    node [fillcolor="#e2e8f0"];

    rsp  [label="robot_state_publisher\nURDF TF\n(wheels, lidar, imu)"];
    ekf  [label="ekf_local\n(robot_localization)\nsingle odom stream:\nvx + vyaw only", fillcolor="#e2e8f0"];
    slam [label="slam_toolbox\n(lifecycle, async)\n/scan → /map\n+ TF map→odom"];
    spawners [label="controller spawners\n(load+activate, ~t+9 s)", fillcolor="#dbeafe"];
    e2e  [label="scripts/sim_e2e_run.py\n10 Hz drive, ATE +\nmap-vs-GT metrics", fillcolor="#fee2e2"];
  }

  subgraph cluster_ros {
    label="ROS topics";
    fontsize=12; color="#94a3b8"; style="rounded";
    node [shape=ellipse, style="filled", fillcolor="#fef9c3"];

    t_scan_r [label="/scan\n30 Hz"];
    t_imu_r  [label="/imu/data\n50 Hz"];
    t_gto_r  [label="/gt_odom\n50 Hz (eval)"];
    t_odom   [label="/odom\n30 Hz (EKF)"];
    t_map    [label="/map\n0.5 Hz"];
  }

  spawners -> gzc   [label="load + activate"];
  gzc -> ddc;
  gzc -> jsb;
  t_cmdvel -> ddc   [label="10 Hz"];
  ddc -> t_podom;
  jsb -> t_js;
  lidar -> t_scan;
  imus -> t_imu;
  gto -> t_gto;
  t_scan -> bridge;
  t_imu -> bridge;
  t_gto -> bridge;
  t_clock -> bridge;
  bridge -> t_scan_r;
  bridge -> t_imu_r;
  bridge -> t_gto_r;
  t_js -> rsp;
  t_podom -> ekf;
  ekf -> t_odom;
  t_scan_r -> slam;
  slam -> t_map;
  e2e -> t_cmdvel;
  e2e -> t_odom   [style=dashed, label="metrics"];
  e2e -> t_gto_r  [style=dashed];
  e2e -> t_map    [style=dashed];
}
